    {
        "id": "973f65a544157492",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Symulator",
        "func": "\n/**\n* @param {number} min\n* @param {number} max\n*/\n\nfunction losuj(min, max) {\n    return Math.floor(Math.random() * (max - min + 1)) + min;\n}\n\nlet id = Math.floor(Math.random() * 10000);\n\n\nlet ok = Math.random() > 0.1;\n\nmsg.payload = {\n    produkt: id,\n    jakosc: ok ? \"OK\" : \"BRAK\",\n    czas: new Date().toISOString()\n};\n\nmsg.payload.temperatura = losuj(30, 58);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 100,
        "wires": [
            [
                "4c2b868cc6125bf8",
                "c7f9d7e2d7fb21eb",
                "4ff5e63f02520079",
                "3b670f9bd96a1a3e"
            ]
        ]
    },
    {
        "id": "4c2b868cc6125bf8",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Licznik",
        "func": "let count = context.get(\"count\") || 0;\n\ncount++;\n\ncontext.set(\"count\", count);\n\nmsg.payload = count;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1010,
        "y": 100,
